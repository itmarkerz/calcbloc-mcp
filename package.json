{
  "name": "calcbloc-mcp",
  "version": "0.1.2",
  "description": "MCP server for take-home pay, employer cost, salary comparison and official tax tables in 41 countries, with the tax year and official sources in every answer.",
  "mcpName": "io.github.itmarkerz/calcbloc-mcp",
  "type": "module",
  "bin": {
    "calcbloc-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "tax",
    "income-tax",
    "take-home-pay",
    "salary-calculator",
    "net-salary",
    "employer-cost",
    "payroll",
    "tax-tables",
    "calcbloc"
  ],
  "author": "itmarkerz technologies (https://itmarkerz.co.in)",
  "license": "MIT",
  "homepage": "https://calcbloc.com/developers?utm_source=calcbloc-mcp&utm_medium=package&utm_campaign=itmarkerz-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmarkerz/calcbloc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/itmarkerz/calcbloc-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
