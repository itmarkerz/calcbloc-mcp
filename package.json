{
  "name": "calcbloc-mcp",
  "version": "0.3.0",
  "description": "MCP server for take-home pay, employer cost, salary comparison, bonus withholding, RSU and stock option tax, and official tax tables in 41 countries, with the tax year and official sources in every answer.",
  "mcpName": "io.github.itmarkerz/calcbloc-mcp",
  "type": "module",
  "bin": {
    "calcbloc-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm test",
    "coverage": "node scripts/gen-coverage.mjs",
    "coverage:check": "node scripts/gen-coverage.mjs --check test/fixtures/countries.json",
    "test:schema": "vitest run test/phase1.test.ts test/phase2.test.ts -t schema",
    "test:golden": "vitest run test/phase1.test.ts test/phase2.test.ts -t golden"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "tax",
    "income-tax",
    "take-home-pay",
    "salary-calculator",
    "net-salary",
    "employer-cost",
    "bonus-tax",
    "supplemental-withholding",
    "rsu",
    "stock-options",
    "equity-compensation",
    "payroll",
    "tax-tables",
    "calcbloc"
  ],
  "author": "itmarkerz technologies (https://itmarkerz.co.in)",
  "license": "MIT",
  "homepage": "https://calcbloc.com/developers?utm_source=calcbloc-mcp&utm_medium=package&utm_campaign=itmarkerz-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmarkerz/calcbloc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/itmarkerz/calcbloc-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
